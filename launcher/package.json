{
  "name": "the-age-after-launcher",
  "productName": "The Age After",
  "version": "0.1.8",
  "private": true,
  "description": "Лаунчер модового сервера The Age After",
  "author": "Makarexe",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview:ui": "vite --config vite.ui.config.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "release": "electron-vite build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@xmcl/core": "2.15.1",
    "@xmcl/installer": "6.1.2",
    "@xmcl/unzip": "2.1.2",
    "electron-updater": "^6.8.9",
    "undici": "7.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.0.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
