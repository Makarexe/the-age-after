# Copy to .env for local development: `npm run dev` loads it.
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/theageafter
# Public URL of this server, no trailing slash. It is the authlib-injector API root.
PUBLIC_URL=http://localhost:3000
# Optional RSA private key in PEM (npm run gen-key); never commit it.
# Without it the server generates a key on first start and keeps it in the database.
SIGNING_PRIVATE_KEY=
# Minecraft server address shown to the launcher (host:port).
SERVER_ADDRESS=
# Defaults to the pack-latest GitHub Release of this repo.
PACK_MANIFEST_URL=
# SMTP. Without SMTP_HOST mails go to the log and email verification is skipped.
# Yandex: smtp.yandex.ru, 465, SMTP_SECURE=true, app password. Gmail: smtp.gmail.com, 465, true, app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Age After <you@yandex.ru>"
# Gets an email about every new registration.
ADMIN_NOTIFY_EMAIL=
# Nicknames that are always active admins (comma-separated).
ADMIN_USERNAMES=
