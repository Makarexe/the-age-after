{
  "name": "the-age-after-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Account server for The Age After: Yggdrasil API (authlib-injector), launcher API, admin panel",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:generate": "drizzle-kit generate",
    "gen-key": "tsx scripts/gen-key.ts",
    "make-admin": "node dist/scripts/make-admin.js"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.9.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
